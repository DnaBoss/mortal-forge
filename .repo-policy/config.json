  "default_branch": "main",
  "legacy_branches": [
    "chore/agent-guards",
    "chore/track-agents-and-tools",
    "develop",
    "feat/localai-and-remote-zip-mcp",
    "feature/orca-claude-env",
    "main"
  ],
  "deployment_branches": [],
  "deployment_tags": false,
  "checks": [
    {
      "pattern": "^\\.repo-policy/",
      "pre_commit": [
        "python3",
        ".repo-policy/test_policy.py"
      ],
      "pre_push": [
        "python3",
        ".repo-policy/test_policy.py"
      ],
      "timeout": 60
    },
    {
      "pattern": "^(?!\\.repo-policy/).*\\.rs$|(^|/)Cargo\\.(toml|lock)$|^rustfmt\\.toml$",
      "requires": "Cargo.toml",
      "pre_commit": [
        "cargo",
        "fmt",
        "--manifest-path",
        "Cargo.toml",
        "--all",
        "--",
        "--check"
      ],
      "pre_push": [
        "cargo",
        "fmt",
        "--manifest-path",
        "Cargo.toml",
        "--all",
        "--",
        "--check"
      ]
    },
    {
      "pattern": "^(?!\\.repo-policy/).*\\.rs$|(^|/)Cargo\\.(toml|lock)$|^rustfmt\\.toml$",
      "requires": "Cargo.toml",
      "pre_push": [
        "cargo",
        "clippy",
        "--manifest-path",
        "Cargo.toml",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "pattern": "^(?!\\.repo-policy/).*\\.rs$|(^|/)Cargo\\.(toml|lock)$|^rustfmt\\.toml$",
      "requires": "Cargo.toml",
      "pre_push": [
        "cargo",
        "test",
        "--manifest-path",
        "Cargo.toml",
        "--workspace"
      ]
    },
    {
      "pattern": "^(src/|server/.*\\.[cm]?[jt]s|package(?:-lock)?\\.json$|.*\\.(tsx?|jsx?|css)$|.*config\\.[cm]?[jt]s$)",
      "requires": "package.json",
      "pre_push": [
        "npm",
        "run",
        "test"
      ]
    }
  ],
